{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckflow.dev/schemas/core/envelope.schema.json",
  "title": "deckflow-core result envelope",
  "description": "The single result shape every deckflow-core command writes to stdout and to --report. JSON is the default output; --human replaces it with prose for people, never for parsers.",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "core_version",
    "status",
    "started_at",
    "finished_at",
    "extract",
    "inputs",
    "outputs",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "command": { "type": "string", "minLength": 1 },
    "core_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["succeeded", "partial", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "extract": {
      "description": "The one brokered provider. Null when the command never resolved it.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/extract" }]
    },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/fileRecord" } },
    "outputs": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "env": {
      "description": "Present on `env check`. See env.schema.json.",
      "type": "object"
    },
    "cloud": {
      "description": "Present on `auth status`. Same shape as env.cloud.",
      "type": "object"
    },
    "provider_result": {
      "description": "The provider's own payload, carried verbatim so normalization is lossless."
    }
  },
  "$defs": {
    "extract": {
      "type": "object",
      "required": ["status", "version", "pinned_version", "package", "resolution", "acquired", "download_mb"],
      "properties": {
        "status": { "enum": ["ready", "not-acquired"] },
        "version": { "type": ["string", "null"] },
        "pinned_version": { "type": "string" },
        "package": { "type": "string" },
        "resolution": { "enum": ["override", "ambient", "managed", "acquired", "missing"] },
        "acquired": {
          "type": "boolean",
          "description": "True when this run downloaded the provider."
        },
        "download_mb": {
          "type": "integer",
          "description": "Approximate download on first use, for warning a user before a long job."
        },
        "path": { "type": "string" }
      }
    },
    "fileRecord": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["rule_id", "severity", "message"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "location": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" },
        "recovery": { "type": "string" }
      }
    }
  }
}
